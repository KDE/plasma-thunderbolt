#: kded_bolt.cpp:67
#, kde-format
msgid "New Thunderbolt Device Detected"
msgstr "Ανιχνεύθηκε νέα συσκευή Thunderbolt"

#: kded_bolt.cpp:68
#, kde-format
msgid ""
"Unauthorized Thunderbolt device <b>%1</b> was detected. Do you want to "
"authorize it?"
msgstr ""
"Ανιχνεύτηκε μη εξουσιοδοτημένη συσκευή Thunderbolt <b>%1</b>. Θέλετε να την "
"εξουσιοδοτήσετε;"

#: kded_bolt.cpp:70
#, kde-format
msgid ""
"%1 unauthorized Thunderbolt device was detected. Do you want to authorize it?"
msgid_plural ""
"%1 unauthorized Thunderbolt devices were detected. Do you want to authorize "
"them?"
msgstr[0] ""
"Ανιχνεύτηκε %1 εξουσιοδοτημένη συσκευή Thunderbolt. Θέλετε να την "
"εξουσιοδοτήσετε;"
msgstr[1] ""
"Ανιχνεύτηκαν %1 εξουσιοδοτημένες συσκευές Thunderbolt. Θέλετε να τις "
"εξουσιοδοτήσετε;"

#: kded_bolt.cpp:78
#, kde-format
msgid "Authorize Now"
msgstr "Εξουσιοδότηση τώρα"

#: kded_bolt.cpp:83
#, kde-format
msgid "Authorize Permanently"
msgstr "Μόνιμη εξουσιοδότηση"

#: kded_bolt.cpp:131
#, kde-format
msgid "Thunderbolt Device Authorization Error"
msgstr "Σφάλμα εξουσιοδότησης συσκευής Thunderbolt"

#: kded_bolt.cpp:132
#, kde-format
msgid "Failed to authorize Thunderbolt device <b>%1</b>: %2"
msgstr "Αποτυχία εξουσιοδότησης συσκευής Thunderbolt <b>%1</b>: %2"
