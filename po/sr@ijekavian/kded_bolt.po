#: kded_bolt.cpp:67
#, kde-format
msgid "New Thunderbolt Device Detected"
msgstr "Откривен нов тандерболт уређај"

#: kded_bolt.cpp:68
#, kde-format
msgid ""
"Unauthorized Thunderbolt device <b>%1</b> was detected. Do you want to "
"authorize it?"
msgstr ""
"Откривен је неовлашћен тандерболт уређај <b>%1</b>. Желите ли да га "
"овластите?"

#: kded_bolt.cpp:70
#, kde-format
msgid ""
"%1 unauthorized Thunderbolt device was detected. Do you want to authorize it?"
msgid_plural ""
"%1 unauthorized Thunderbolt devices were detected. Do you want to authorize "
"them?"
msgstr[0] ""
"Откривен је %1 неовлашћен тандерболт уређај. Желите ли да их овластите?"
msgstr[1] ""
"Откривена су %1 неовлашћена тандерболт уређаја. Желите ли да их овластите?"
msgstr[2] ""
"Откривено је %1 неовлашћених тандерболт уређаја. Желите ли да их овластите?"
msgstr[3] ""
"Откривен је један неовлашћен тандерболт уређај. Желите ли да га овластите?"

#: kded_bolt.cpp:78
#, kde-format
msgid "Authorize Now"
msgstr "Овласти сада"

#: kded_bolt.cpp:83
#, kde-format
msgid "Authorize Permanently"
msgstr "Овласти трајно"

#: kded_bolt.cpp:131
#, kde-format
msgid "Thunderbolt Device Authorization Error"
msgstr "Грешка при овлашћивању тандерболт уређаја"

#: kded_bolt.cpp:132
#, kde-format
msgid "Failed to authorize Thunderbolt device <b>%1</b>: %2"
msgstr "Не могу да овластим тандерболт уређај <b>%1</b>: %2"
