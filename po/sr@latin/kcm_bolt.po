#: ui/DeviceView.qml:105 ui/DeviceView.qml:125
#, kde-format
msgid "Failed to enroll device <b>%1</b>: %2"
msgstr "Ne mogu da upišem uređaj <b>%1</b>: %2"

#: ui/DeviceView.qml:112
#, kde-format
msgid "Trust this Device"
msgstr "Veruj ovom uređaju"

#: ui/DeviceView.qml:133
#, kde-format
msgid "Revoke Trust"
msgstr "Opozovi poverenje"

#: ui/DeviceView.qml:145
#, kde-format
msgid "Error changing device trust: <b>%1</b>: %2"
msgstr "Greška pri promeni poverenja u uređaj: <b>%1</b>: %2"

#: ui/DeviceView.qml:161
#, kde-format
msgid ""
"Hint: trusted device will be automatically authorized the next time it is "
"connected to the computer."
msgstr ""
"Savet: pouzdan uređaj biće automatski ovlašćen sledeći put kad se poveže sa "
"računarom."

#: ui/DeviceView.qml:162
#, kde-format
msgid ""
"Hint: an untrusted device needs to be manually authorized each time it is "
"connected to the computer."
msgstr ""
"Savet: nepouzdan uređaj mora se ručno ovlastiti svaki put kad se poveže sa "
"računarom."

#: ui/main.qml:31
#, kde-format
msgctxt "@option:check Enable Thunderbolt subsystem"
msgid "Enable"
msgstr "Uključi"

#: ui/main.qml:32
#, kde-format
msgctxt "@option:check"
msgid "Enable Thunderbolt subsystem"
msgstr "Uključi tanderbolt podsistem"

#: ui/main.qml:63
#, kde-format
msgid "Thunderbolt support has been disabled in BIOS"
msgstr "Podrška za tanderbolt je isključena u BIOS‑u"

#: ui/main.qml:64
#, kde-format
msgid "Follow your system manufacturer's guide to enable Thunderbolt support"
msgstr ""
"Pratite uputstvo proizvođača sistema da biste uključili podršku za tanderbolt"

#: ui/main.qml:70
#, kde-format
msgid "No Thunderbolt devices connected"
msgstr "Nema povezanih tanderbolt uređaja"

#: ui/main.qml:71
#, kde-format
msgid "Plug in a Thunderbolt device"
msgstr "Utaknite tanderbolt uređaj"

#: ui/main.qml:85
#, kde-format
msgid "Thunderbolt subsystem is disabled or unavailable"
msgstr "Tanderbolt podsistem je isključen ili nedostupan"

#: ui/main.qml:86
#, kde-format
msgid ""
"If the device supports Thunderbolt, try plugging in a Thunderbolt device"
msgstr ""
"Ako uređaj podržava tanderbolt, pokušajte da utaknete tanderbolt uređaj"

